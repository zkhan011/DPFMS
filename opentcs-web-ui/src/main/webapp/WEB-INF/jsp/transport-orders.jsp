<%-- Web frontend component for DPW FMS. Author: Zishan Khan. --%>
<%@ include file="layout/header.jsp" %><h1>Transport Orders</h1>
<form id="order-form" class="toolbar"><label>Name <input name="name" required></label><label>Source <select name="source" id="order-source" required></select></label><label>Destination <select name="destination" id="order-destination" required></select></label><label>Optional vehicle <input name="intendedVehicle"></label><button>Create order</button></form>
<section class="toolbar"><label>Search <input id="job-search" placeholder="Job, container, origin or destination"></label><label>Status <select id="job-status"><option value="">All statuses</option><option>Pending</option><option>Assigned</option><option>In progress</option><option>Completed</option><option>Delayed</option><option>Failed</option></select></label><label>Priority <select id="job-priority"><option value="">All priorities</option></select></label><label>Type <select id="job-type"><option value="">All types</option></select></label><label>SLA <select id="job-sla"><option value="">All SLA</option></select></label></section><div class="table-wrap"><table><thead><tr><th>Name</th><th>State</th><th>Intended vehicle</th><th>Processing vehicle</th><th>Source</th><th>Destination</th><th>Created</th><th>Finished</th></tr></thead><tbody id="order-rows"></tbody></table></div>
<script defer src="${pageContext.request.contextPath}/static/js/orders.js"></script><%@ include file="layout/footer.jsp" %>
