<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0">
  <display-name>DPW FMS Fleet Management System</display-name>
  <servlet><servlet-name>dashboard</servlet-name><servlet-class>org.opentcs.web.controller.DashboardController</servlet-class></servlet>
  <servlet><servlet-name>plant</servlet-name><servlet-class>org.opentcs.web.controller.PlantOverviewController</servlet-class></servlet>
  <servlet><servlet-name>map</servlet-name><servlet-class>org.opentcs.web.controller.MapController</servlet-class></servlet>
  <servlet><servlet-name>vehicles</servlet-name><servlet-class>org.opentcs.web.controller.VehicleController</servlet-class></servlet>
  <servlet><servlet-name>orders</servlet-name><servlet-class>org.opentcs.web.controller.TransportOrderController</servlet-class></servlet>
  <servlet><servlet-name>control</servlet-name><servlet-class>org.opentcs.web.controller.ControlCenterController</servlet-class></servlet>
  <servlet><servlet-name>api</servlet-name><servlet-class>org.opentcs.web.controller.ApiController</servlet-class></servlet>
  <servlet><servlet-name>reports</servlet-name><servlet-class>org.opentcs.web.controller.ReportsController</servlet-class></servlet>
  <servlet-mapping><servlet-name>dashboard</servlet-name><url-pattern>/dashboard</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>plant</servlet-name><url-pattern>/plant-overview</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>map</servlet-name><url-pattern>/map-overview</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>vehicles</servlet-name><url-pattern>/vehicles</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>orders</servlet-name><url-pattern>/transport-orders</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>control</servlet-name><url-pattern>/control-center</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>api</servlet-name><url-pattern>/api/*</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>reports</servlet-name><url-pattern>/reports</url-pattern></servlet-mapping>
  <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
</web-app>
